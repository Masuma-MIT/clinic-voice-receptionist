# Copy to .env locally and supply authorised credentials.
# Never commit the completed .env file.
DEEPGRAM_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternatively, use SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Telephone configuration: current public HTTPS tunnel URL.
TWILIO_PUBLIC_BASE_URL=
MAX_CONCURRENT_PHONE_CALLS=4

# Additional telephone speaker verification requires its
# separate environment, model files and Hugging Face access.
SPEAKER_GUARD_V3_ENABLED=true
SPEAKER_GUARD_V3_TIMEOUT_SECONDS=35
SPEAKER_GUARD_V3_WARMUP_TIMEOUT_SECONDS=120

# Optional persistent voice profiles are disabled here.
VOICE_IDENTITY_ENABLED=false
VOICE_IDENTITY_KEY=